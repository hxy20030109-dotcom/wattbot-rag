# Optional OpenAI-compatible generation endpoint. The first baseline is retrieval-only.
WATTBOT_LLM_BASE_URL=
WATTBOT_LLM_API_KEY=
WATTBOT_LLM_MODEL=
WATTBOT_LLM_BACKEND=openai_compatible
# The frozen local baseline runner configures these from configs/bm25_local_v1.json.
WATTBOT_LLM_CONTEXT=8192
WATTBOT_LLM_MAX_TOKENS=2048
WATTBOT_LLM_THINK=low

